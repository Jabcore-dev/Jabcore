# Lokální vývoj. Zkopíruj do .env.local (to je v .gitignore):
#
#   cp .env.example .env.local
#   docker compose up -d
#   npm run dev
#
# Na serveru se nic z tohohle nepoužívá - tam hodnoty skládá build.sh
# z deploy/<env>.env a deploy/secrets.<env>.env.

# Vývojová databáze z docker-compose.yml. Port 5434, protože 5432 drží
# databáze jabcore-finance.
DATABASE_URL=postgresql://jabcore:jabcore@127.0.0.1:5434/jabcore

# Adresy obou webů. Lokálně stačí localhost; portfolio se testuje přes
# portfolio.localhost, které moderní prohlížeče i curl řeší na 127.0.0.1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTFOLIO_URL=http://portfolio.localhost:3000
NEXT_PUBLIC_SITE_ENV=test

# Podepisovací klíč session admin panelu. Lokálně je jedno jaký, na serveru ne.
AUTH_SECRET=dev-secret-nepouzivat-na-serveru-aspon-32-znaku

# Kam se ukládají nahrané obrázky. Lokálně složka v projektu (je v .gitignore),
# na serveru Docker volume /app/uploads.
UPLOADS_DIR=./uploads

# Klíč ke Gemini API pro automatický překlad referencí v adminu. Nepovinný -
# bez něj jen chybí tlačítka překladu. Skutečný klíč patří do .env.local,
# nikdy sem.
GEMINI_API_KEY=
