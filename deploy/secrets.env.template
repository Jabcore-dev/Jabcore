# Šablona secrets. Zkopíruj pro konkrétní prostředí, NEcommituj vyplněnou verzi:
#
#   cp deploy/secrets.env.template deploy/secrets.production.env
#   chmod 600 deploy/secrets.production.env
#   $EDITOR deploy/secrets.production.env
#
# Soubor žije na serveru a přežije každý git pull.

# Heslo k databázi.
#   openssl rand -hex 24
#
# Jen A-Z a-z 0-9 _ - — skládá se z něj DATABASE_URL a znaky jako @ : / %
# by URL rozbily. build.sh to kontroluje a odmítne nasadit.
#
# POZOR: Postgres si heslo uloží při PRVNÍM startu do volume. Pozdější změna
# tady ho uvnitř databáze nepřepíše — musí se změnit i tam:
#   docker exec -it jabcore-db psql -U jabcore -d jabcore \
#     -c "ALTER USER jabcore WITH PASSWORD 'nove';"
POSTGRES_PASSWORD=

# Podepisovací klíč session cookie admin panelu. Minimálně 32 znaků.
#   openssl rand -hex 32
#
# Změna odhlásí všechny přihlášené. Když unikne, dá se s ním podepsat platná
# session — proto není v gitu.
AUTH_SECRET=
