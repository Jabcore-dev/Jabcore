# Prostředí: PRODUKCE  (jabcore.cz + portfolio.jabcore.cz)
#
# Veřejné, ne-tajné hodnoty jednoho nasazení. Čte je ./build.sh a předává
# docker-compose.prod.yml. Tenhle soubor je v gitu - secrets sem nepatří,
# ty žijí v deploy/secrets.production.env přímo na serveru.
#
# Domény musí sedět s deploy/Caddyfile.

# Hlavní web. Odvozují se z něj canonical URL, hreflang a sitemapa, a je to to,
# co build.sh vypíše na konci - ať je vidět, kam se právě nasadilo.
PUBLIC_BASE_URL=https://jabcore.cz

# Portfolio onepager. Stejná aplikace, jiný Host hlavička - rozlišuje je
# src/middleware.ts. Zapéká se do image stejně jako PUBLIC_BASE_URL.
PORTFOLIO_BASE_URL=https://portfolio.jabcore.cz

# Kde leží secrets tohohle prostředí. Čte to build.sh i docker-compose.prod.yml,
# takže i ruční `docker compose --env-file deploy/production.env … ps` ví, kde je
# heslo k databázi. Soubor sám v gitu není - viz deploy/README.md.
SECRETS_FILE=deploy/secrets.production.env

# --- Umístění na stroji ------------------------------------------------------
# Kontejnery se jmenují ${STACK_PREFIX}-db / -web a port se publikuje jen na
# BIND_ADDRESS, protože ven ho pouští Caddy.
STACK_PREFIX=jabcore
BIND_ADDRESS=127.0.0.1
WEB_PORT=13100

# COMPOSE_PROJECT_NAME záměrně nenastavujeme: compose ho odvodí z názvu složky
# a je v něm jméno volume s databází i s nahranými obrázky. Změnit ho na
# běžícím serveru = compose sáhne po novém prázdném volume a obsah "zmizí"
# (zůstane viset jako osiřelý volume). Nastavuj ho jen na čerstvé instalaci.
# COMPOSE_PROJECT_NAME=jabcore
