# Prostředí: TEST  (jabcore.jabcore.cloud)
#
# Testovací instance běží ze stejného repozitáře jako produkce, jen s vlastní
# databází a vlastním image. NEXT_PUBLIC_SITE_ENV=test z ní dělá neindexovanou
# instanci — viz src/app/robots.ts.

PUBLIC_BASE_URL=https://jabcore.jabcore.cloud
PORTFOLIO_BASE_URL=https://portfolio.jabcore.jabcore.cloud

SECRETS_FILE=deploy/secrets.test.env

# Vlastní prefix a port, aby test mohl běžet na stejném stroji jako produkce,
# aniž by si sáhly na kontejnery nebo volume.
STACK_PREFIX=jabcore-test
BIND_ADDRESS=127.0.0.1
WEB_PORT=13101

# Test má vlastní compose projekt, tedy i vlastní volume — jinak by sdílel
# databázi s produkcí, protože oba stacky leží ve stejné složce.
COMPOSE_PROJECT_NAME=jabcore-test
